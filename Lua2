-- // Mobile UI Scale & Auto-Center Engine
local UIScaleInstance = nil
local TargetGui = nil

task.spawn(function()
    task.wait(0.5)
    for _, gui in ipairs({gethui and gethui(), CoreGui, LocalPlayer:FindFirstChild("PlayerGui")}) do
        if gui then
            TargetGui = gui:FindFirstChild("Fatality") or gui:FindFirstChild("FatalityWin") or gui:FindFirstChild("FatalityUI") or gui:FindFirstChildOfClass("ScreenGui")
            if TargetGui and TargetGui.Name ~= "FatalityMobileToggle" then break end
        end
    end

    if TargetGui then
        local mainFrame = TargetGui:FindFirstChildOfClass("Frame") or TargetGui:FindFirstChild("Main") or TargetGui:FindFirstChild("Window")
        if mainFrame then
            -- Inject scale reducer
            UIScaleInstance = mainFrame:FindFirstChild("UIScale") or Instance.new("UIScale")
            UIScaleInstance.Scale = UserInputService.TouchEnabled and 0.65 or 1.0
            UIScaleInstance.Parent = mainFrame
            
            -- Lock frame to screen center
            mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
            mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        end
    end
end)

